<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com"
            fx:controller="com.example.lab6.MouseController">
    <center>
        <Canvas fx:id="canvas" width="600" height="400"/>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Add a circle" onAction="#onAddCircleClick"/>
            <Button text="Add a rectangle" onAction="#onAddRectangleClick"/>
        </HBox>
    </bottom>
</BorderPane>
